---
import type { Locale, PostSummary } from "@/lib/content";
import { getMessages, localeHref } from "@/lib/i18n";

/**
 * 트레이스 레일 — 구조적 장치이지 장식이 아니다 (docs/DESIGN.md §6).
 *
 * WRITING-GUIDE 가 트러블슈팅 글에 의무화한 환경 정보(발행일·수정일·태그)의
 * 지정석이다. 코드 에디터의 라인 넘버 거터에서 온 형태이고,
 * 이 블로그가 매번 싣는 정보라서 존재한다.
 *
 * 1024px 미만에서는 가로 메타 스트립으로 접힌다 — 숨기지 않는다.
 */
interface Props {
  post: PostSummary;
  locale: Locale;
}

const { post, locale } = Astro.props;
const m = getMessages(locale);
---

<aside class="rail" aria-label={m.post.environment}>
  <dl class="dates">
    <dt class="label">{m.post.publishedOn}</dt>
    <dd class="value"><time datetime={post.date}>{post.date}</time></dd>

    {
      post.updated && (
        <>
          <dt class="label">{m.post.updatedOn}</dt>
          <dd class="value">
            <time datetime={post.updated}>{post.updated}</time>
          </dd>
        </>
      )
    }
  </dl>

  {
    post.tags.length > 0 && (
      <ul class="tags">
        {post.tags.map((tag) => (
          <li>
            <a href={localeHref(locale, `/tags/${tag}`)} class="tag">
              #{tag}
            </a>
          </li>
        ))}
      </ul>
    )
  }
</aside>

<style>
  .rail {
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    color: var(--color-ink-muted);
    line-height: 1.7;
  }

  .dates {
    margin: 0;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0 0.75rem;
  }

  .label {
    color: var(--color-ink-faint);
    letter-spacing: 0.04em;
  }

  .value {
    margin: 0;
    font-variant-numeric: tabular-nums;
  }

  .tags {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
    padding-block-start: 1rem;
    border-block-start: 1px solid var(--color-rule);
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
  }

  .tag {
    color: var(--color-ink-faint);
    text-decoration: none;
    transition: color var(--duration-fast) ease;
  }

  .tag:hover {
    color: var(--color-signal-resolved);
  }

  /* ≥1024px: 좌측 고정 컬럼으로 스크롤을 따라간다. */
  @media (min-width: 1024px) {
    .rail {
      position: sticky;
      inset-block-start: 5rem;
    }
  }

  /* <1024px: 가로 메타 스트립으로 접힌다. 정보가 사라지면 안 된다. */
  @media (max-width: 1023px) {
    .rail {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0.5rem 1.5rem;
      padding-block: 0.85rem;
      border-block: 1px solid var(--color-rule);
    }

    .dates {
      display: flex;
      flex-wrap: wrap;
      gap: 0.25rem 0.6rem;
    }

    .tags {
      margin: 0;
      padding: 0;
      border: 0;
    }
  }
</style>
