---
/**
 * 테마 초기화 — 첫 페인트 전에 동기 실행되어야 FOUC가 없다.
 *
 * 저장된 선택이 없으면 data-theme 을 설정하지 않는다.
 * 그래야 CSS의 prefers-color-scheme 분기가 그대로 동작한다.
 *
 * is:inline 이라 Astro 번들러를 거치지 않고 그대로 인라인된다.
 */
---

<script is:inline>
  (function () {
    try {
      const t = localStorage.getItem("theme");
      if (t === "dark" || t === "light") {
        document.documentElement.setAttribute("data-theme", t);
      }
    } catch {
      // 저장소 접근 불가(사파리 프라이빗 등) — 시스템 테마를 그대로 따른다.
    }
  })();
</script>
