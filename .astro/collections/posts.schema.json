{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "minLength": 50,
      "maxLength": 300
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "draft": {
      "type": "boolean"
    },
    "slug": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "summary": {
      "type": "string",
      "maxLength": 500
    },
    "tags": {
      "default": [],
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      }
    },
    "category": {
      "type": "string",
      "enum": [
        "troubleshooting",
        "insight",
        "note",
        "retrospective"
      ]
    },
    "canonical": {
      "type": "string",
      "format": "uri"
    },
    "series": {
      "type": "string"
    },
    "related": {
      "default": [],
      "maxItems": 5,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 80,
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "cover": {
      "type": "object",
      "properties": {
        "src": {
          "type": "string",
          "pattern": "^\\/images\\/.*"
        },
        "alt": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "src",
        "alt"
      ]
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "description",
    "date",
    "draft"
  ]
}